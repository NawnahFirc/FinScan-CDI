    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.0.9",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
