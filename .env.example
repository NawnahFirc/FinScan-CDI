# FinScan Corporate Decision Intelligence - environment configuration
#
# The app works without any of these. Local parsing, ratios, scoring,
# simulations, exports and local memos need no API key.
# To use: copy this file to ".env" and fill in only what you need.
# Keys belong in server environment variables only - never in VITE_* variables.

# --- Optional AI providers (first configured one is used: Gemini, then OpenAI, then Anthropic) ---
GEMINI_API_KEY=
# GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
# GEMINI_REPORT_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
# OPENAI_EXTRACTION_MODEL=gpt-5.5
# OPENAI_REPORT_MODEL=gpt-5.5

AI_ANALYST_API_KEY=
# AI_ANALYST_MODEL=claude-sonnet-5-5

# --- Server ---
PORT=3000

# Browser origins allowed to call the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Number of reverse proxies in front of the app (0 when exposed directly).
# Set this only to match your real proxy topology.
TRUST_PROXY_HOPS=0

# Rate limits.
API_RATE_LIMIT_MAX=90
PARSE_RATE_LIMIT_MAX=12

# Production only, when the backend is on a different origin than the frontend.
# VITE_BACKEND_URL=https://your-app.example.com
