# FinScan Corporate Decision Intelligence - environment configuration
#
# The app works without these optional values. Configure them only when
# you want to run the backend AI analyst service.
#
# To use: copy this file to ".env" and fill in the values below.

# Anthropic API key for the optional AI analyst service.
AI_ANALYST_API_KEY=

# Optional Anthropic model override.
# AI_ANALYST_MODEL=claude-sonnet-4-20250514

# Backend port.
PORT=3000

# Browser origins allowed to call the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits.
API_RATE_LIMIT_MAX=90
PARSE_RATE_LIMIT_MAX=12

# Production only: set this to your deployed backend URL.
# VITE_BACKEND_URL=https://your-app.example.com
